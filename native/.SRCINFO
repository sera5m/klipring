pkgbase = klipring
	pkgdesc = Radial Ctrl+V clipboard pie for KDE Plasma
	pkgver = 0.1.26
	pkgrel = 1
	url = https://github.com/sera5m/klipring
	install = klipring.install
	arch = any
	license = MIT
	makedepends = git
	depends = python
	depends = pyside6
	depends = qt6-base
	depends = qt6-wayland
	depends = wl-clipboard
	optdepends = ydotool: paste into the focused window on KWin (recommended)
	optdepends = dotool: paste injector fallback
	optdepends = wtype: paste on compositors that implement virtual-keyboard (not KWin)
	optdepends = xdotool: paste on X11
	optdepends = kdotool: AUR package — place the pie on the cursor under KWin (yay -S kdotool)
	optdepends = kate: open clips in the default KDE editor
	optdepends = kwriteconfig6: auto-bind the Ctrl+V shortcut on first run
	source = git+https://github.com/sera5m/klipring.git#tag=v0.1.26
	sha256sums = SKIP

pkgname = klipring
