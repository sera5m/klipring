pkgbase = klipring
	pkgdesc = Radial Ctrl+V clipboard pie for KDE Plasma
	pkgver = 0.1.4
	pkgrel = 1
	url = https://github.com/sera5m/klipring
	install = klipring.install
	arch = any
	license = MIT
	makedepends = git
	depends = python
	depends = pyside6
	depends = qt6-base
	depends = qt6-wayland
	optdepends = wtype: paste into the focused window on Wayland (recommended)
	optdepends = ydotool: Wayland paste fallback
	optdepends = xdotool: paste on X11
	optdepends = wl-clipboard: extra clipboard sync
	optdepends = kate: open clips in the default KDE editor
	optdepends = kwriteconfig6: auto-bind the Ctrl+V shortcut on first run
	source = git+https://github.com/sera5m/klipring.git#branch=main
	sha256sums = SKIP

pkgname = klipring
