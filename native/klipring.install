post_install() {
  echo ""
  echo "==> KlipRing"
  echo "    Start it:        klipring   (or log out — autostart is installed)"
  echo "    Do not run it in a terminal: Ctrl+C in that TTY is SIGINT, not copy."
  echo "    Paste helper:    sudo pacman -S ydotool"
  echo "                     (KWin has no virtual keyboard protocol; wtype will fail)"
  echo "    Bind the chord:  klipring --bind-shortcut"
  echo "                     (writes ~/.config/kglobalshortcutsrc — no sudo)"
  echo "    Then confirm:    System Settings → Keyboard → Shortcuts → KlipRing"
  echo "    Default chord is Ctrl+V at the KWin layer. Ctrl+C is never stolen;"
  echo "    copies are watched from the clipboard like Klipper."
  echo ""
}

post_upgrade() {
  post_install
}

post_remove() {
  echo "==> KlipRing removed. Delete leftover state with:"
  echo "    rm -rf ~/.local/share/klipring ~/.config/klipring"
  echo "    rm -f ~/.local/share/applications/klipring-show.desktop"
}
