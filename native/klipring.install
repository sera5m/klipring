post_install() {
  echo ""
  echo "==> KlipRing"
  echo "    Daemon (once):   klipring &  disown"
  echo "                 or  systemctl --user enable --now klipring"
  echo "    Bind the chord:  tray → Bind Alt+V in KWin"
  echo "                 or  klipring --bind-shortcut"
  echo "    Ctrl+V is normal paste. Alt+V opens the pie."
  echo "    Pointer helper:  yay -S kdotool     (AUR, not pacman extra)"
  echo "    Paste helper:    sudo pacman -S ydotool"
  echo "    Tray: uncheck Notify on paste to silence toasts."
  echo "    Do not Ctrl+C a foreground klipring — that kills the daemon."
  echo ""
}

post_upgrade() {
  post_install
}

post_remove() {
  echo "==> KlipRing removed. Delete leftover state with:"
  echo "    rm -rf ~/.local/share/klipring ~/.config/klipring"
  echo "    rm -f ~/.local/share/applications/klipring-show.desktop"
  echo "    systemctl --user disable --now klipring 2>/dev/null || true"
}
